{
  "name": "aidraw",
  "productName": "AIDraw",
  "version": "0.1.0-alpha.1",
  "description": "Agent-native mixed-media and pixel-art studio",
  "license": "MIT",
  "author": "AIDraw contributors",
  "homepage": "https://github.com/hokomili/AIDraw",
  "repository": {
    "type": "git",
    "url": "https://github.com/hokomili/AIDraw.git"
  },
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:engine": "electron-forge start -- --headless",
    "qa:runtime": "node scripts/require-node24.mjs",
    "check:portability": "node scripts/check-portability.mjs --include-untracked",
    "prepackage": "npm run qa:runtime",
    "package": "electron-forge package",
    "postpackage": "node scripts/verify-package.mjs",
    "premake": "node scripts/prepare-make-output.mjs",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --cache=false",
    "test:watch": "vitest",
    "test:e2e": "npm run package && npm run test:e2e:only",
    "test:e2e:only": "playwright test",
    "test:e2e:retained": "node scripts/run-packaged-e2e.mjs retained",
    "test:macos-headless-lifecycle": "node scripts/run-macos-headless-lifecycle-acceptance.mjs",
    "test:performance": "vitest run --cache=false --config vitest.performance.config.ts",
    "pretest:level1:auto": "npm run qa:runtime",
    "test:level1:auto": "npm run verify && npm run package",
    "pretest:level2:auto": "npm run qa:runtime",
    "test:level2:auto": "npm run verify && npm run package && npm run test:e2e:only",
    "pretest:level3:auto": "npm run qa:runtime",
    "test:level3:auto": "npm run release:windows",
    "checksums": "node scripts/checksums.mjs",
    "licenses": "node scripts/license-report.mjs",
    "security:manifests": "node scripts/dependency-security.mjs",
    "security:audit:runtime": "npm audit --omit=dev --audit-level=high",
    "security:audit:complete": "npm audit --include=prod --include=dev --include=optional --include=peer --audit-level=high",
    "security:audit:signatures": "npm audit signatures",
    "security:verify": "npm run security:manifests && npm run security:audit:runtime && npm run security:audit:complete && npm run security:audit:signatures",
    "provenance": "node scripts/release-provenance.mjs capture",
    "reproducibility:compare": "node scripts/release-provenance.mjs compare",
    "rc:audit": "node scripts/check-rc-readiness.mjs --audit",
    "rc:verify": "node scripts/check-rc-readiness.mjs",
    "verify": "npm run check:portability && npm run typecheck && npm run lint && npm run test",
    "release:current": "npm run verify && npm run test:performance && npm run security:verify && npm run make && node scripts/verify-package.mjs && npm run checksums && npm run licenses && npm run provenance",
    "release:windows": "npm run release:current && npm run test:e2e:only"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@napi-rs/canvas": "1.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "ag-psd": "31.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canvas": "3.2.0-aidraw.1",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "hono": "4.13.0",
    "immer": "11.1.15",
    "lucide-react": "1.28.0",
    "paper": "0.12.18",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "perfect-freehand": "1.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "upng-js": "2.1.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@aidraw/core": "0.1.0-alpha.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/paper": "0.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/upng-js": "2.1.5",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.4.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
